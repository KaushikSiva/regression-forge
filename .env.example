# Actual SigNoz evidence is required by default. Set true only for the labeled local-audit fallback.
ALLOW_LOCAL_OTEL_AUDIT=false

# Self-hosted SigNoz API, UI, OTLP receiver, and demo viewer account.
SIGNOZ_URL=http://host.docker.internal:8080
SIGNOZ_UI_URL=http://host.docker.internal:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
SIGNOZ_EMAIL=
SIGNOZ_PASSWORD=

# Real integrations. Missing services remain visibly PARTIAL/UNAVAILABLE.
GREPTILE_API_KEY=
GREPTILE_REPOSITORY=owner/regressionforge-demo-store
CLAUDE_MEM_URL=
CODEX_ENABLED=false
CODEX_MODEL=gpt-5.6-terra
